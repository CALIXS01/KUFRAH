generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Planta {
  id            Int      @id @default(autoincrement())
  especie       String
  cuidado       String
  regamento     String
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  @@map("plantas")
}